# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Los_Angeles

# API Keys
PERPLEXITY_API_KEY=your-perplexity-api-key-here
PERPLEXITY_REASONING=high  # Options: low, medium, high (default: high)
OPENAI_API_KEY=your-openai-api-key-here  # Optional: for OpenAI provider
COINGECKO_API_KEY=your-coingecko-api-key-here  # Optional but recommended: for market data (avoids rate limits)

# Ghost Configuration
GHOST_URL=https://your-ghost-site.com
GHOST_ADMIN_API_KEY=your-ghost-admin-api-key-here

# LLM Provider Configuration
LLM_CHAT_PROVIDER=perplexity  # Options: perplexity, openai

# Email Configuration (Ghost)
GHOST_FROM_EMAIL=noreply@your-ghost-site.com
GHOST_FROM_NAME=Squid Digest

# Email Recipients
ADMIN_EMAILS=squid@leviathannews.xyz
PUBLIC_EMAILS=squid@leviathannews.xyz,kraken@leviathannews.xyz

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHANNEL_ID=your-telegram-channel-id-here

# Substack Configuration (for RSS import automation)
SUBSTACK_URL=https://leviathannews.substack.com
SUBSTACK_SESSION_COOKIES=[{"name":"substack.sid","value":"your-session-id","domain":".substack.com","path":"/","expires":-1,"httpOnly":true,"secure":true}]
SUBSTACK_EMAIL=your-substack-email@example.com
SUBSTACK_PASSWORD=your-substack-password-here
